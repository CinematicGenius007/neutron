{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neutron.example/schema/crypto-envelope-v1.schema.json",
  "title": "Neutron executable crypto envelope vector catalog v1",
  "$comment": "Only complete deterministic inputs and exact machine-verifiable results belong here. Coverage planning belongs in crypto-envelope-v1.pending.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "catalogVersion", "cases"],
  "properties": {
    "format": { "const": "neutron-crypto-vectors/v1" },
    "catalogVersion": { "const": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$" },
    "nonEmptyHex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})+$" },
    "passwordBytes": { "type": "string", "pattern": "^(?:[0-9a-f]{2}){1,1024}$" },
    "bytes16": { "type": "string", "pattern": "^(?:[0-9a-f]{2}){16}$" },
    "bytes24": { "type": "string", "pattern": "^(?:[0-9a-f]{2}){24}$" },
    "bytes32": { "type": "string", "pattern": "^(?:[0-9a-f]{2}){32}$" },
    "bytes1to128": { "type": "string", "pattern": "^(?:[0-9a-f]{2}){1,128}$" },
    "bytes72": { "type": "string", "pattern": "^(?:[0-9a-f]{2}){72}$" },
    "envelopeKeySource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "password"],
          "properties": {
            "source": { "const": "password" },
            "password": { "$ref": "#/$defs/passwordBytes" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "parentKey"],
          "properties": {
            "source": { "const": "parent" },
            "parentKey": { "$ref": "#/$defs/bytes32" }
          }
        }
      ]
    },
    "uint64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]|1844674407370955161[0-5])$"
    },
    "unicodeScalar": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1114111,
      "not": { "minimum": 55296, "maximum": 57343 }
    },
    "error": {
      "enum": [
        "authentication",
        "bounds",
        "invalid-password-encoding",
        "kdf-policy",
        "non-atomic-migration",
        "padding",
        "password-length",
        "structure",
        "unknown-critical-field",
        "unsupported-suite",
        "unsupported-version"
      ]
    },
    "byteSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "output"],
      "properties": {
        "outcome": { "const": "success" },
        "output": {
          "oneOf": [
            { "$ref": "#/$defs/hex" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["repeatByte", "repeatCount"],
              "properties": {
                "repeatByte": { "type": "string", "pattern": "^[0-9a-f]{2}$" },
                "repeatCount": { "type": "integer", "minimum": 0, "maximum": 1025 }
              }
            }
          ]
        }
      }
    },
    "exactByteSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "output"],
      "properties": {
        "outcome": { "const": "success" },
        "output": { "$ref": "#/$defs/hex" }
      }
    },
    "stateGenerationSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "state"],
      "properties": {
        "outcome": { "const": "success" },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation"],
          "properties": { "generation": { "$ref": "#/$defs/uint64" } }
        }
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "error"],
      "properties": { "outcome": { "const": "reject" }, "error": { "$ref": "#/$defs/error" } }
    },
    "expect": {
      "oneOf": [
        { "$ref": "#/$defs/byteSuccess" },
        { "$ref": "#/$defs/stateGenerationSuccess" },
        { "$ref": "#/$defs/rejection" }
      ]
    },
    "hkdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "originatingRequirementId", "operation", "input", "parameters", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "originatingRequirementId": { "$ref": "#/$defs/id" },
        "operation": { "const": "hkdf-sha256" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ikm", "salt", "info"],
          "properties": {
            "ikm": { "$ref": "#/$defs/nonEmptyHex" },
            "salt": { "$ref": "#/$defs/hex" },
            "info": { "$ref": "#/$defs/hex" }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["length"],
          "properties": { "length": { "type": "integer", "minimum": 1, "maximum": 8160 } }
        },
        "expect": { "$ref": "#/$defs/exactByteSuccess" }
      }
    },
    "argon2id": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "originatingRequirementId", "operation", "input", "parameters", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "originatingRequirementId": { "$ref": "#/$defs/id" },
        "operation": { "const": "argon2id" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["password", "salt"],
          "properties": {
            "password": { "$ref": "#/$defs/nonEmptyHex" },
            "salt": { "$ref": "#/$defs/bytes16" }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "memoryKiB", "iterations", "parallelism", "length", "provider"],
          "properties": {
            "version": { "const": 19 },
            "memoryKiB": { "const": 65536 },
            "iterations": { "const": 3 },
            "parallelism": { "const": 1 },
            "length": { "const": 32 },
            "provider": { "const": "libsodium-crypto-pwhash-argon2id13" }
          }
        },
        "expect": { "$ref": "#/$defs/exactByteSuccess" }
      }
    },
    "passwordUnicodeScalars": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "originatingRequirementId", "operation", "input", "parameters", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "originatingRequirementId": { "$ref": "#/$defs/id" },
        "operation": { "const": "password-encoding" },
        "input": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["scalars"],
              "properties": {
                "scalars": { "type": "array", "items": { "$ref": "#/$defs/unicodeScalar" } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["repeatScalar", "repeatCount"],
              "properties": {
                "repeatScalar": { "$ref": "#/$defs/unicodeScalar" },
                "repeatCount": { "type": "integer", "minimum": 0, "maximum": 1025 }
              }
            }
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "encoding", "normalization"],
          "properties": {
            "source": { "const": "unicode-scalars" },
            "encoding": { "const": "utf8" },
            "normalization": { "const": "none" }
          }
        },
        "expect": { "oneOf": [{ "$ref": "#/$defs/byteSuccess" }, { "$ref": "#/$defs/rejection" }] }
      }
    },
    "passwordUtf16Be": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "originatingRequirementId", "operation", "input", "parameters", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "originatingRequirementId": { "$ref": "#/$defs/id" },
        "operation": { "const": "password-encoding" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["utf16be"],
          "properties": { "utf16be": { "$ref": "#/$defs/nonEmptyHex" } }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "adapter"],
          "properties": {
            "encoding": { "const": "utf16be" },
            "adapter": { "const": "reject-unpaired-surrogates" }
          }
        },
        "expect": { "$ref": "#/$defs/rejection" }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "originatingRequirementId", "operation", "input", "parameters", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "originatingRequirementId": { "$ref": "#/$defs/id" },
        "operation": { "const": "envelope" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["envelope", "keySource"],
          "properties": {
            "envelope": { "$ref": "#/$defs/nonEmptyHex" },
            "keySource": { "$ref": "#/$defs/envelopeKeySource" }
          }
        },
        "parameters": { "type": "object", "additionalProperties": false },
        "expect": {
          "oneOf": [{ "$ref": "#/$defs/exactByteSuccess" }, { "$ref": "#/$defs/rejection" }]
        }
      }
    },
    "stateGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "originatingRequirementId", "operation", "input", "parameters", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "originatingRequirementId": { "$ref": "#/$defs/id" },
        "operation": { "const": "state-generation" },
        "input": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "candidateGeneration", "kind"],
              "properties": {
                "action": { "const": "validate" },
                "candidateGeneration": { "$ref": "#/$defs/uint64" },
                "kind": { "enum": ["blob", "index", "item", "root"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "currentGeneration", "kind"],
              "properties": {
                "action": { "const": "increment" },
                "currentGeneration": { "$ref": "#/$defs/uint64" },
                "kind": { "enum": ["blob", "index", "item", "root"] }
              }
            }
          ]
        },
        "parameters": { "type": "object", "additionalProperties": false },
        "expect": {
          "oneOf": [{ "$ref": "#/$defs/stateGenerationSuccess" }, { "$ref": "#/$defs/rejection" }]
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "originatingRequirementId", "operation", "input", "parameters", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "originatingRequirementId": { "$ref": "#/$defs/id" },
        "operation": { "const": "migration" },
        "input": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "oldArk", "newArk", "children"],
              "properties": {
                "action": { "const": "minimum-child-rewrap" },
                "oldArk": { "$ref": "#/$defs/bytes32" },
                "newArk": { "$ref": "#/$defs/bytes32" },
                "children": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["oldEnvelope", "newNonce"],
                    "properties": {
                      "oldEnvelope": { "$ref": "#/$defs/nonEmptyHex" },
                      "newNonce": { "$ref": "#/$defs/bytes24" }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action",
                "accountId",
                "newArk",
                "newKeyVersion",
                "objectIds",
                "materials",
                "nonces"
              ],
              "properties": {
                "action": { "const": "full-descendant-rotation" },
                "accountId": { "$ref": "#/$defs/bytes16" },
                "newArk": { "$ref": "#/$defs/bytes32" },
                "newKeyVersion": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
                "objectIds": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mutation", "vault", "item", "attachment", "index"],
                  "properties": {
                    "mutation": { "$ref": "#/$defs/bytes16" },
                    "vault": { "$ref": "#/$defs/bytes16" },
                    "item": { "$ref": "#/$defs/bytes16" },
                    "attachment": { "$ref": "#/$defs/bytes16" },
                    "index": { "$ref": "#/$defs/bytes16" }
                  }
                },
                "materials": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mutation",
                    "vaultKey",
                    "itemKey",
                    "attachmentKey",
                    "itemPlaintext",
                    "blobPlaintext",
                    "indexPlaintext"
                  ],
                  "properties": {
                    "mutation": { "$ref": "#/$defs/bytes1to128" },
                    "vaultKey": { "$ref": "#/$defs/bytes32" },
                    "itemKey": { "$ref": "#/$defs/bytes32" },
                    "attachmentKey": { "$ref": "#/$defs/bytes32" },
                    "itemPlaintext": { "$ref": "#/$defs/hex" },
                    "blobPlaintext": { "$ref": "#/$defs/hex" },
                    "indexPlaintext": { "$ref": "#/$defs/hex" }
                  }
                },
                "nonces": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mutationChild",
                    "vaultChild",
                    "itemWrapper",
                    "attachmentWrapper",
                    "itemPayload",
                    "blobPayload",
                    "indexPayload"
                  ],
                  "properties": {
                    "mutationChild": { "$ref": "#/$defs/bytes24" },
                    "vaultChild": { "$ref": "#/$defs/bytes24" },
                    "itemWrapper": { "$ref": "#/$defs/bytes24" },
                    "attachmentWrapper": { "$ref": "#/$defs/bytes24" },
                    "itemPayload": { "$ref": "#/$defs/bytes24" },
                    "blobPayload": { "$ref": "#/$defs/bytes24" },
                    "indexPayload": { "$ref": "#/$defs/bytes24" }
                  }
                }
              }
            }
          ]
        },
        "parameters": { "type": "object", "additionalProperties": false },
        "expect": {
          "oneOf": [{ "$ref": "#/$defs/exactByteSuccess" }, { "$ref": "#/$defs/rejection" }]
        }
      }
    },
    "case": {
      "oneOf": [
        { "$ref": "#/$defs/hkdf" },
        { "$ref": "#/$defs/argon2id" },
        { "$ref": "#/$defs/passwordUnicodeScalars" },
        { "$ref": "#/$defs/passwordUtf16Be" },
        { "$ref": "#/$defs/envelope" },
        { "$ref": "#/$defs/stateGeneration" },
        { "$ref": "#/$defs/migration" }
      ]
    }
  }
}
