{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neutron.example/schema/crypto-envelope-v1.schema.json",
  "title": "Neutron immutable crypto envelope vector catalog v1",
  "$comment": "This schema validates vector syntax. Cryptographic verification is performed only by a runtime adapter against the supplied expected values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "catalogVersion", "cases"],
  "properties": {
    "format": { "const": "neutron-crypto-vectors/v1" },
    "catalogVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "scalar": {
      "anyOf": [{ "type": "boolean" }, { "type": "integer" }, { "type": "string" }]
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["success", "reject"] },
        "output": { "$ref": "#/$defs/hex" },
        "error": {
          "enum": [
            "authentication",
            "bounds",
            "invalid-password-encoding",
            "kdf-policy",
            "non-atomic-migration",
            "padding",
            "password-length",
            "structure",
            "unknown-critical-field",
            "unsupported-suite",
            "unsupported-version"
          ]
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "success" } } },
          "then": {
            "anyOf": [
              { "required": ["output"], "properties": { "output": {} } },
              { "required": ["assertions"], "properties": { "assertions": {} } }
            ]
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "reject" } } },
          "then": { "required": ["error"], "properties": { "error": {} } }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "input", "parameters", "expect"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "operation": {
          "enum": [
            "argon2id",
            "envelope",
            "hkdf-sha256",
            "migration",
            "password-encoding",
            "state-generation"
          ]
        },
        "input": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        },
        "expect": { "$ref": "#/$defs/expect" }
      }
    }
  }
}
